# Environment Variables Template for Studymines
# Copy this file to .env and fill in your values

# Database Connection
DATABASE_URL=sqlite:///./studymines.db

# Gemini API Key (Get from https://aistudio.google.com)
GOOGLE_API_KEY=your_gemini_api_key

# Application Settings
DEBUG=False
APP_NAME=Studymines
APP_VERSION=1.0.0

# Optional: Upload configurations
MAX_FILE_SIZE=52428800  # 50 MB in bytes
MAX_IMAGE_SIZE=10485760  # 10 MB in bytes
